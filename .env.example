# Local Action / DB input placeholders.
# Copy to `.env` (gitignored) and fill in only what you need.
# Leave passwords empty in committed files; set them only in your private `.env`.
# Values below match CI Postgres service defaults (local/dev only — not production).

ENGINE=postgres
SQL_FILE=examples/mixed_postgres.sql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test_db
DB_USER=postgres
# Required for `docker compose up` and live engine analysis (CI uses `root`).
DB_PASSWORD=
