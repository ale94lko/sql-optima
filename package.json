{
  "name": "sql-optima-action",
  "version": "1.1.3",
  "description": "Automated SQL performance analyzer & optimization engine for GitHub Actions",
  "license": "MIT",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ale94lko/sql-optima.git"
  },
  "bugs": {
    "url": "https://github.com/ale94lko/sql-optima/issues"
  },
  "homepage": "https://github.com/ale94lko/sql-optima#readme",
  "keywords": [
    "github-actions",
    "sql",
    "linter",
    "optimizer",
    "performance",
    "postgres",
    "mysql",
    "mariadb",
    "sqlite",
    "mssql",
    "explain",
    "schema"
  ],
  "scripts": {
    "build": "ncc build src/index.js -o dist --license licenses.txt && node scripts/copy-sqljs-wasm.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "integration": "node scripts/run-integration.js"
  },
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/github": "^8.0.1",
    "mssql": "^12.7.2",
    "mysql2": "^3.9.0",
    "node-sql-parser": "^5.1.0",
    "pg": "^8.11.3",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.2",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
